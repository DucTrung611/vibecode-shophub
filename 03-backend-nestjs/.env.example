# --- Docker Compose (docker-compose.yml) ---
DB_USER=shophub
DB_PASSWORD=shophub
DB_NAME=shophub
DB_PORT=5432
REDIS_PASSWORD=shophub
REDIS_PORT=6379
ADMINER_PORT=8080

# --- App runtime config (config/configuration.ts) ---
DATABASE_URL=postgresql://shophub:shophub@localhost:5432/shophub?schema=public
REDIS_URL=redis://:shophub@localhost:6379
PORT=6060
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
